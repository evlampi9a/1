# --- OAuth 2.1 Authorization Server (MCP integration) ---
# Backend issuer URL — must match what MCP clients resolve `/.well-known/oauth-authorization-server` against.
OAUTH_ISSUER_URL                            = "https://api.zncr.pro"
# JSON list of allowed `resource` values (RFC 8707). MCP server URLs that can be audiences.
OAUTH_ALLOWED_RESOURCES                     = ["https://mcp.zncr.pro"]
# Fallback `resource` for clients that omit the RFC 8707 parameter (e.g. Grok/ChatGPT). Must be one of OAUTH_ALLOWED_RESOURCES.
OAUTH_DEFAULT_RESOURCE                      = "https://mcp.zncr.pro"
# TTLs (seconds)
OAUTH_AUTH_CODE_TTL_SECONDS                 = 600
OAUTH_ACCESS_TOKEN_TTL_SECONDS              = 3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS             = 2592000
# Dynamic Client Registration rate limit per IP per hour.
OAUTH_REGISTRATION_RATE_LIMIT_PER_HOUR      = 10
# Pre-provisioned MCP service client (introspection caller). Use a fixed UUID + a long random secret.
# Seed once with: `make seed-mcp-client`
OAUTH_MCP_SERVICE_CLIENT_ID                 =
OAUTH_MCP_SERVICE_CLIENT_SECRET             =

# Fernet key for encrypting admin TOTP entry secrets at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY        =

RENDER_BACKEND_URL                          = http://127.0.0.1:8080
RENDER_BACKEND_SHARED_SECRET                =

