NAME                        = "CreatorOS"
DESCRIPTION                 = "CreatorOS core backend"
VERSION                     = "0.1.0"
DEBUG                       = true

SCALAR_VERSION              = "1.32.0"
OPENAPI_PATH                = "/docs"
OPENAPI_EXISTS              = true

CORS_ALLOW_ORIGINS          = ["http://localhost:8080", "http://localhost:5173", "http://zc.vpn:5173", "http://zc.local:5173"]
CORS_ALLOW_HEADERS          = ["*"]
CORS_ALLOW_METHODS          = ["*"]
CORS_EXPOSE_HEADERS         = ["*"]
CORS_MAX_AGE                = 600

SESSION_STORE_KEY           = "session"
SECURE                      = false
HTTPONLY                    = true
SAMESITE                    = "none"
MAX_AGE                     = 1209600
# Parent domain for the JS-readable user id cookie the frontend reads for Unleash targeting.
# Empty keeps it host-only, i.e. invisible to a frontend served from another host.
USER_ID_COOKIE_DOMAIN       = ""

