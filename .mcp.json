{
  "mcpServers": {
    "grafana": {
      "type": "stdio",
      "command": "go",
      "args": [
        "run",
        "github.com/grafana/mcp-grafana/cmd/mcp-grafana@v1.6.3"
      ],
      "env": {
        "GRAFANA_URL": "${GRAFANA_URL}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_SERVICE_ACCOUNT_TOKEN}"
      }
    }
  }
}